{
	"name": "nextsaas-theme",
	"private": true,
	"type": "module",
	"description": "Build pipeline for the NextSaaS child theme (Nextora parent).",
	"scripts": {
		"build": "npm run build:css && npm run build:ts && npm run build:blocks",
		"build:blocks": "node ./scripts/build-blocks.mjs",
		"build:css": "postcss ./resources/css/nextsaas.css -o ./assets/css/nextsaas.css --verbose && postcss ./resources/css/nextsaas-editor.css -o ./assets/css/nextsaas-editor.css --verbose",
		"build:package": "node ./scripts/build-package.mjs",
		"build:ts": "node ./scripts/build-ts.mjs",
		"ci": "npm run typecheck && npm run lint:php:all && npm run build && composer test",
		"lint:php": "composer phpstan",
		"lint:php:all": "composer phpstan && composer php-cs-fixer:check",
		"lint:php:check": "composer php-cs-fixer:check",
		"lint:php:fix": "composer php-cs-fixer",
		"test:wp": "bash scripts/wp-test.sh",
		"typecheck": "tsc --noEmit",
		"watch": "concurrently --group -n CSS,TS,Blocks -c cyan,yellow,magenta \"npm run -s watch:css\" \"npm run -s watch:ts\" \"npm run -s watch:blocks\"",
		"watch:blocks": "node ./scripts/build-blocks.mjs --watch",
		"watch:css": "node ./scripts/watch-css.mjs",
		"watch:ts": "node ./scripts/build-ts.mjs --watch"
	},
	"devDependencies": {
		"@tailwindcss/postcss": "^4.2.2",
		"@types/react": "^18.3.0",
		"@types/react-dom": "^18.3.0",
		"@types/wordpress__block-editor": "^15.0.5",
		"@types/wordpress__blocks": "^15.10.2",
		"@wordpress/block-editor": "^15.16.0",
		"@wordpress/blocks": "^15.16.0",
		"@wordpress/components": "^32.5.0",
		"@wordpress/core-data": "^9.0.0",
		"@wordpress/data": "^10.57.0",
		"@wordpress/element": "^6.43.0",
		"@wordpress/i18n": "^6.16.0",
		"@wordpress/server-side-render": "^6.19.0",
		"@wp-playground/cli": "^3.1.60",
		"chokidar-cli": "^3.0.0",
		"concurrently": "^9.2.1",
		"esbuild": "^0.25.0",
		"glob": "^13.0.6",
		"postcss": "^8.5.3",
		"postcss-cli": "^11.0.1",
		"tailwindcss": "^4.2.2",
		"typescript": "^5.8.2"
	}
}
