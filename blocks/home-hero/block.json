			"type": "string",
			"default": "LESS NOISE. MORE POSSIBILITY."
		},
		"heading": {
			"type": "string",
			"default": "Make space<br>for the <em>next.</em>"
		},
		"orbitCopy": {
			"type": "string",
			"default": "GOOD IDEAS NEED<br>ROOM TO BECOME<br>GREAT WORK."
		},
		"lead": {
			"type": "string",
			"default": "Projects. People. Possibilities. Bring them together in one thoughtful workspace — and give your best work room to happen."
		},
		"primaryLabel": {
			"type": "string",
			"default": "Find your next"
		},
		"primaryUrl": {
			"type": "string",
			"default": ""
		},
		"workspaceLabel": {
			"type": "string",
			"default": "Meet the workspace"
