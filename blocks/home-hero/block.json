		"mediaAlt": {
			"type": "string",
			"default": ""
		},
		"placeholderLabel": {
			"type": "string",
			"default": "Image placeholder: Your whole world of work."
		},
		"placeholderTop": {
			"type": "string",
			"default": "NS—01"
		},
		"placeholderBadge": {
			"type": "string",
			"default": "PRODUCT IMAGE"
		},
		"placeholderTitle": {
			"type": "string",
			"default": "Your whole world of work."
		},
		"placeholderNote": {
			"type": "string",
			"default": "Screenshot reserved"
		},
		"placeholderFoot": {
			"type": "string",
			"default": "REPLACE WITH YOUR PRODUCT"
		},
		"placeholderAspect": {
			"type": "string",
			"default": "3.25 / 1"
		},
		"caption": {
			"type": "string",
			"default": "01 — THE NEXTSAAS WORKSPACE"
		},
		"captionNote": {
			"type": "string",
			"default": "PRODUCT IMAGE PLACEHOLDER / REPLACE WITH YOUR SCREENSHOT"
