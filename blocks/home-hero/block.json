{
	"$schema": "https://schemas.wp.org/trunk/block.json",
	"apiVersion": 3,
	"name": "nextsaas/home-hero",
	"version": "1.0.0",
	"title": "Home hero",
	"category": "nextsaas",
	"icon": "layout",
