		"useCasesLabel": {
			"type": "string",
			"default": "MADE FOR PEOPLE WHO MAKE THINGS."
		},
		"useCases": {
			"type": "array",
			"default": [
				{
					"label": "Product & engineering",
					"url": "#teams",
					"pick": "product"
				},
				{
					"label": "Design & creative",
					"url": "#teams",
					"pick": "design"
				},
				{
					"label": "Marketing & operations",
					"url": "#teams",
					"pick": "marketing"
				}
			]
		}
	},
	"supports": {
		"html": false,
		"anchor": true
	},
	"editorScript": "file:./index.js",
	"editorStyle": "file:./editor.css",
	"render": "file:./render.php"
