{
	"$schema": "https://schemas.wp.org/trunk/block.json",
	"apiVersion": 3,
	"name": "nextsaas/site-footer",
	"version": "1.0.0",
	"title": "Site footer",
	"category": "nextsaas",
	"icon": "editor-insertmore",
	"description": "Site-wide newsletter, navigation, social connections and legal footer.",
	"keywords": [ "footer", "newsletter", "social", "navigation" ],
	"textdomain": "nextsaas",
	"attributes": {
		"sectionId": { "type": "string", "default": "" },
		"newsletterHeading": { "type": "string", "default": "A little perspective.<br>Not another distraction." },
		"newsletterLabel": { "type": "string", "default": "NEXT NOTES / OCCASIONAL IDEAS FOR BETTER WORK" },
		"newsletterPlaceholder": { "type": "string", "default": "Your email address" },
		"newsletterButtonLabel": { "type": "string", "default": "Subscribe to Next notes" },
		"newsletterNote": { "type": "string", "default": "Preview only. No emails sent or subscriptions created." },
		"newsletterStatusText": { "type": "string", "default": "" },
		"newsletterSuccessText": { "type": "string", "default": "Email format checked. Preview only — no subscription created." },
		"newsletterAction": { "type": "string", "default": "" },
		"brandMode": { "type": "string", "default": "text" },
		"brandLabel": { "type": "string", "default": "NextSaas" },
		"brandUrl": { "type": "string", "default": "@home" },
		"brandAriaLabel": { "type": "string", "default": "NextSaas home" },
		"brandMediaId": { "type": "number", "default": 0 },
		"brandMediaUrl": { "type": "string", "default": "" },
		"brandMediaAlt": { "type": "string", "default": "" },
		"aboutLineOne": { "type": "string", "default": "A home for ambitious ideas.<br>And the people behind them." },
		"aboutLineTwo": { "type": "string", "default": "Independent in spirit.<br>Connected by design." },
		"columns": { "type": "array", "default": [
			{ "heading": "THE WORKSPACE", "links": [ { "label": "Overview", "url": "product.html", "element": "a" }, { "label": "Capabilities", "url": "product.html#capabilities", "element": "a" }, { "label": "Automations", "url": "product.html#workflow", "element": "a" }, { "label": "Access & control", "url": "product.html#control", "element": "a" }, { "label": "Plans & pricing", "url": "pricing.html", "element": "a" } ] },
			{ "heading": "FOR YOUR TEAM", "links": [ { "label": "Product teams", "url": "product.html#perspectives", "element": "a" }, { "label": "Design teams", "url": "product.html#perspectives", "element": "a" }, { "label": "Marketing teams", "url": "product.html#perspectives", "element": "a" }, { "label": "Getting started", "url": "product.html#workflow", "element": "a" } ] },
			{ "heading": "A LITTLE MORE", "links": [ { "label": "The field guide", "url": "archive.html", "element": "a" }, { "label": "Questions & answers", "url": "faqs.html", "element": "a" }, { "label": "About NextSaas", "url": "about-us.html", "element": "a" }, { "label": "Contact us", "url": "contact-us.html", "element": "a" }, { "label": "Search the site", "url": "search.html", "element": "a" }, { "label": "Say hello", "url": "", "element": "button" }, { "label": "Back to the top", "url": "@home#top", "element": "a" } ] }
		] },
		"socialHeading": { "type": "string", "default": "Connect with us" },
		"socialNote": { "type": "string", "default": "Preview only · Social profiles coming soon." },
		"socialAriaLabel": { "type": "string", "default": "Social connections" },
		"socialButtons": { "type": "array", "default": [ { "label": "LinkedIn", "icon": "linkedin" }, { "label": "Instagram", "icon": "instagram" }, { "label": "YouTube", "icon": "youtube" }, { "label": "GitHub", "icon": "github" } ] },
		"wordmark": { "type": "string", "default": "NextSaas" },
		"copyright": { "type": "string", "default": "© 2026 NextSaas. An independent template concept." },
		"bottomItems": { "type": "array", "default": [ { "label": "Privacy notice", "element": "button", "href": "" }, { "label": "Template terms", "element": "button", "href": "" }, { "label": "EN / ENGLISH", "element": "text", "href": "" } ] },
		"dialogEyebrow": { "type": "string", "default": "NEXTSAAS / PREVIEW" },
		"dialogCloseLabel": { "type": "string", "default": "Close dialog" },
		"socialTitleSuffix": { "type": "string", "default": " connection" },
		"socialDialogBody": { "type": "string", "default": "This social profile is not configured yet. Add the official NextSaas profile URL before publishing." },
		"privacyDialogTitle": { "type": "string", "default": "Privacy in this preview" },
		"termsDialogTitle": { "type": "string", "default": "Template terms" },
		"legalDialogBody": { "type": "string", "default": "This independent template concept has no connected service. Forms validate in your browser and do not send or save personal information. Replace this notice with approved legal content before publishing." }
	},
	"supports": { "html": false, "anchor": true },
	"editorScript": "file:./index.js",
	"editorStyle": "file:./editor.css",
	"render": "file:./render.php",
	"viewScript": "file:./view.js"
}
