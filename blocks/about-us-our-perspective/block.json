{
	"$schema": "https://schemas.wp.org/trunk/block.json",
	"apiVersion": 3,
	"name": "nextsaas/about-us-our-perspective",
	"version": "1.0.0",
	"title": "Our perspective",
	"category": "nextsaas",
	"icon": "layout",
	"description": "Point-of-view section with editorial copy",
	"keywords": [
		"about",
		"editorial",
		"section"
	],
	"textdomain": "nextsaas",
	"attributes": {
		"sectionBg": {
			"type": "string",
			"default": ""
		},
		"sectionHeading": {
			"type": "string",
			"default": ""
		},
		"sectionText": {
			"type": "string",
			"default": ""
		},
		"sectionGap": {
			"type": "string",
			"default": ""
		},
		"sectionId": {
			"type": "string",
			"default": "our-perspective"
		},
		"eyebrow": {
			"type": "string",
			"default": "OUR POINT OF VIEW"
		},
		"heading": {
			"type": "string",
			"default": "More connected.<br>Less consumed."
		},
		"lead": {
			"type": "string",
			"default": "Work doesn’t need another place to become busy. It needs a place to become clear."
		},
		"bodyOne": {
			"type": "string",
			"default": "NextSaas explores a simple idea: bring the plan, the reasoning, and the people closer together. Not to measure every moment, but to make the next move easier to understand."
		},
		"bodyTwo": {
			"type": "string",
			"default": "That means less hunting for context. Fewer disconnected handoffs. And more room for the part of work that asks something of us."
		}
	},
	"supports": {
		"spacing": { "margin": true, "padding": true },
		"color": { "background": false, "text": false, "link": false },
		"html": false,
		"anchor": true
	},
