includes:
	- vendor/szepeviktor/phpstan-wordpress/extension.neon

parameters:
	bootstrapFiles:
		- phpstan-bootstrap.php
	level: 8
	treatPhpDocTypesAsCertain: false
	paths:
		- functions.php
		- inc
		- blocks
		- patterns
	excludePaths:
		analyse:
			# `(?)` marks a path that may legitimately be absent: dependency trees
			# only exist after an install, and PHPStan 2 refuses an exclude entry that
			# matches nothing (the CI PHP job has no `node_modules`).
			- vendor (?)
			- node_modules (?)
			- tests
			- blocks/*/index.js
			- blocks/*/view.js
			- blocks/*/index.asset.php
			- blocks/*/view.asset.php
